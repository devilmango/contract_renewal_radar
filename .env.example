DATABASE_PATH=renewal_radar.db
# Optional LLM extraction. If unset, the deterministic rules extractor is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional SMTP email delivery. Without SMTP settings, notifications are recorded in the audit log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=renewal-radar@example.com
SMTP_STARTTLS=true
ESCALATION_EMAIL=
ESCALATION_AFTER_DAYS=7
