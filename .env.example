DATABASE_PATH=renewal_radar.db
# Generate a bearer token with `renewal-radar create-token`, then add its hash entry here.
RADAR_AUTH_USERS_JSON=[]
# Optional OIDC bearer-token validation (RS256 / ES256, discovery-independent JWKS URL).
OIDC_JWKS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_ROLES_CLAIM=roles
OIDC_TENANT_CLAIM=tenant_id
RADAR_COOKIE_SECURE=true
# Choose auto, rules, openai, anthropic, google, mistral, cohere, or xai.
LLM_PROVIDER=auto
# Security allowlist for providers that may receive contract text. Keep rules only to disable external model sharing.
LLM_ALLOWED_PROVIDERS=rules
# Optional generic override; provider-specific model variables also work.
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-latest
COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Optional SMTP email delivery. Without SMTP settings, notifications are recorded in the audit log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=renewal-radar@example.com
SMTP_STARTTLS=true
ESCALATION_EMAIL=
ESCALATION_AFTER_DAYS=7
# Durable job queue retry and lease behavior.
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_SECONDS=30
JOB_LEASE_SECONDS=120
# Automatic redaction for eligible inactive/expired contract records; 0 disables scheduled retention.
CONTRACT_RETENTION_DAYS=0
# Optional live calendar sync: microsoft or google. Tokens should be rotated by a secret manager.
CALENDAR_PROVIDER=
MS_GRAPH_ACCESS_TOKEN=
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_USER_ID=
MS_GRAPH_CALENDAR_ID=
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=
# Optional cloud PDF intake. Grant read access only to the selected drive/folder.
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
MS_GRAPH_DRIVE_ID=
MS_GRAPH_FOLDER_ITEM_ID=
# Optional evaluation estimate rates; set per selected model in USD per million tokens.
EVAL_INPUT_USD_PER_MILLION_TOKENS=
EVAL_OUTPUT_USD_PER_MILLION_TOKENS=
